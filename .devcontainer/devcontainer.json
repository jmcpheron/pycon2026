{
  "name": "scadia",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12",
  "features": {
    "ghcr.io/astral-sh/uv/uv:1": {}
  },
  "postCreateCommand": "sudo apt-get update && sudo apt-get install -y openscad xvfb && uv sync",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "charliermarsh.ruff",
        "Antyos.openscad"
      ],
      "settings": {
        "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python"
      }
    }
  }
}
